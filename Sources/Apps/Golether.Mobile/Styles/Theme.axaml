<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Golether.Mobile.Controls">
  <!--
    The look of the mobile client, on the colours of the desktop: ink ground, the amber of a projector lamp for what acts,
    teal for what is secure, mono captions.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Golether.Client/Styles/Palette.axaml" />
        <ResourceInclude Source="avares://Golether.Mobile/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="GoletherFont">fonts:Inter#Inter, $Default</FontFamily>
      <SolidColorBrush x:Key="GoletherSecureLight" Color="#7FD1C4" />
      <SolidColorBrush x:Key="GoletherSecureFrame" Color="#734FB3A5" />
      <SolidColorBrush x:Key="GoletherOverFilm" Color="#A60A0F11" />
      <SolidColorBrush x:Key="GoletherOffKey" Color="#3A1F1B" />

      <!-- Text fields: ink in a thin line, the lamp lights the line of the one in use. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#0A0F11" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0A0F11" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0A0F11" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#223036" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#223036" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#F0A860" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#DDE7E5" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#DDE7E5" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7F9491" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#7F9491" />
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

      <!-- Scales: a thin line with the amber part of the way. -->
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F0A860" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#F0A860" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#F0A860" />
      <SolidColorBrush x:Key="SliderTrackFill" Color="#47FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#47FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#47FFFFFF" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#F0A860" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F4BC84" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#D98E45" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text roles -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoletherMuted}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource GoletherMuted}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="23" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.note">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource GoletherMuted}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource GoletherBad}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warningPoint">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="#C4D0CE" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.wordmark">
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="0.3" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource GoletherPanel}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <!-- A word of caution over the screen: a shade lighter than the cards, with a faint amber frame. -->
  <Style Selector="Border.warning">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="#73F0A860" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BoxShadow" Value="0 10 36 0 #26F0A860" />
  </Style>
  <Style Selector="Border.shade">
    <Setter Property="Background" Value="#B8060A0B" />
  </Style>
  <!-- A text the user may copy, in a field of its own. -->
  <Style Selector="Border.field">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{StaticResource GoletherSecureTint}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherSecureFrame}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Margin" Value="4" />
  </Style>
  <Style Selector="Border.code TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource GoletherSecureLight}" />
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherBad}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="12" />
  </Style>
  <Style Selector="Border.overFilm">
    <Setter Property="Background" Value="{StaticResource GoletherOverFilm}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="11,6" />
  </Style>
  <Style Selector="Border.overFilm.start">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
  </Style>
  <!-- The lamp pulses only while the note is on the screen: an endless animation wakes the drawing of the window. -->
  <Style Selector="Border.live Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Over a picture the timeline is away but keeps its place, so the bar above it never moves. -->
  <Style Selector="Slider.timeline.gone">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- The sign of a skip by a double tap on a side of the film; the view lights it for a moment. -->
  <Style Selector="Border.skipHint">
    <Setter Property="Background" Value="{StaticResource GoletherOverFilm}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Border.overFilm.warn">
    <Setter Property="BorderBrush" Value="{StaticResource GoletherAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- A person: the camera, the chosen picture or the coloured letter. -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- The frame lies over the camera: under it the square corners of the picture would cover the round corners of the line. -->
  <Style Selector="Border.frame">
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Border.speaking">
    <Setter Property="BorderBrush" Value="{StaticResource GoletherGood}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="BoxShadow" Value="0 0 14 0 #7362C28E" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{StaticResource GoletherOverFilm}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="5,1" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="13" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
    <Setter Property="BoxShadow" Value="0 6 24 0 #47F0A860" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D98E45" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#5A4632" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherBad}" />
    <Setter Property="Foreground" Value="#1D0D0A" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C9584A" />
  </Style>
  <!-- A quiet link at the foot of the join screen, in the dimmed colour of the words of the code. -->
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource GoletherSecureLight}" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter, Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource GoletherSecureLight}" />
  </Style>
  <Style Selector="Button.link:pressed">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBlock.version">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource GoletherMuted}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
  </Style>
  <!-- An unobtrusive way to another path, under the card of the join screen. -->
  <Style Selector="Button.subtle">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
    <Setter Property="Opacity" Value="0.85" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.subtle /template/ ContentPresenter#PART_ContentPresenter, Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherPanel}" />
  </Style>
  <!-- One of the two kinds of things to show: a film or a folder of photos. -->
  <Style Selector="Button.choice">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,14" />
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
  </Style>
  <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherLine}" />
  </Style>
  <Style Selector="Button.choice.chosen /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource GoletherAccent}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>

  <!-- The keys of the dock. -->
  <Style Selector="Button.key, ToggleButton.key">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.key:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherOffKey}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherBad}" />
  </Style>
  <Style Selector="ToggleButton.key.lamp:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
  </Style>
  <Style Selector="ToggleButton.key:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource GoletherMuted}" />
  </Style>
  <Style Selector="Button.key:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherMuted}" />
  </Style>
  <Style Selector="Button.key.end /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherBad}" />
    <Setter Property="Foreground" Value="#1D0D0A" />
  </Style>

  <!--
    The controls over the film: no plates of their own, the shade under them keeps them readable. A touch leaves the
    button "under the pointer" until the next one, so the plate of the theme for a hovered button would stay behind it:
    there is none, and the press lights a circle, the shape of the button.
  -->
  <Style Selector="Button.film, ToggleButton.film">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.film:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.film:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.film:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.film:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>
  <!-- A control that waits for something (the sound over a picture, the pen over a picture looked at alone) fades. -->
  <Style Selector="Button.film:disabled, ToggleButton.film:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.film:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.film:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="ToggleButton.film:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource GoletherBad}" />
  </Style>
  <!-- A tool in use (the pen, the open chat) glows with the lamp. -->
  <Style Selector="ToggleButton.film.lamp:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33F0A860" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="Button.film.end">
    <Setter Property="Foreground" Value="{StaticResource GoletherBad}" />
  </Style>
  <!-- The play button is the round plate inside it (Border.disc); the button itself has no plate in any state. -->
  <Style Selector="Button.play">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.play /template/ ContentPresenter#PART_ContentPresenter, Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.play Border.disc">
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="Button.play:pressed Border.disc">
    <Setter Property="Background" Value="#D98E45" />
  </Style>

  <!-- The key that takes the chat to its last line: a dark disc with the arrow of the lamp. -->
  <Style Selector="Button.toEnd">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.toEnd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="Button.toEnd:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherPanel}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>

  <!-- A language, a tile, a line of a list. -->
  <Style Selector="Button.plain">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.plain:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.plain:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The mark on the own picture that says a tap changes it. -->
  <Style Selector="Border.avatarBadge">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherPanel}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource GoletherAccentInk}" />
  </Style>
  <Style Selector="Button.option">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.option:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
  </Style>
  <Style Selector="Button.option.add">
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.reaction">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBox.invite">
    <Setter Property="Padding" Value="12,10,4,10" />
  </Style>
  <Style Selector="TextBox.message">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="15,9" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Background" Value="{StaticResource GoletherPanel}" />
  </Style>
  <Style Selector="TextBox.message:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource GoletherPanel}" />
  </Style>

  <!--
    The waiting rings around the logo. They move only on the screen that is shown (Panel.live): the hidden screens stay in
    the tree for the whole session, and an endless animation on them would wake the drawing of the window all the time.
  -->
  <Style Selector="Ellipse.ring">
    <Setter Property="Stroke" Value="{StaticResource GoletherAccent}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Panel.live Ellipse.ring">
    <Style.Animations>
      <Animation Duration="0:0:2.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.7" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="1.25" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Panel.live Ellipse.ring.late">
    <Style.Animations>
      <Animation Duration="0:0:2.4" IterationCount="INFINITE" Delay="0:0:1.2">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.7" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="1.25" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The panel from below. -->
  <Style Selector="controls|BottomSheet">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Dim" Background="#990A0F11" />
          <Border Name="PART_Panel" VerticalAlignment="Bottom" MaxWidth="520" Background="{StaticResource GoletherPanel}" BorderBrush="{StaticResource GoletherLine}"
                  BorderThickness="1,1,1,0" CornerRadius="24,24,0,0">
            <DockPanel>
              <Border Name="PART_Grip" DockPanel.Dock="Top" Height="26" Background="Transparent">
                <Border Width="40" Height="4" CornerRadius="2" Background="{StaticResource GoletherLine}" />
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ContentPresenter Margin="18,0,18,16" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|BottomSheet /template/ Border#PART_Panel">
    <Setter Property="RenderTransform" Value="translateY(90px)" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="controls|BottomSheet.open /template/ Border#PART_Panel">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="controls|BottomSheet /template/ Border#PART_Dim">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="controls|BottomSheet.open /template/ Border#PART_Dim">
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
