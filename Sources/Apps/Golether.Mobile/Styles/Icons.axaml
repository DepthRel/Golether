<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The icons of the mobile client: lines on a 24 by 24 field, drawn by StrokeIcon with round ends, as the antennas of the
    logo are. Only the play triangle is filled.
  -->
