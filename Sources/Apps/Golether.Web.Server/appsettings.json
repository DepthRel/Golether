{
  "Rendezvous": {
    "ListenAddress": "0.0.0.0",
    "Port": 47900,
    "EnableStun": true,
    "MaxConnections": 1024,
    "MaxRooms": 1024,
    "MaxPendingPerRoom": 16,
    "MaxConnectionsPerMinute": 120,
    "MaxStunPerMinute": 600,
    "FirstMessageTimeout": "00:00:10",
    "AnswerTimeout": "00:00:20",
    "IdleTimeout": "00:01:30"
  },
  "Urls": "http://127.0.0.1:47980",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
