<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Golether rendezvous server: introduces a host and a participant that sit behind routers without open ports
    and tells both where to knock, so they punch a direct TCP connection; answers STUN for the cameras and voices.
    It never carries the session itself. Runs on one machine with a public address; see Docs/En/RendezvousServer.md.
  -->
  <PropertyGroup>
    <RootNamespace>Golether.Web.Server</RootNamespace>
    <AssemblyName>golether-server</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>Assets\golether-server.ico</ApplicationIcon>
    <!-- The published server needs neither the XML documentation nor static web files. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Golether.Web.Server.Tests" />
  </ItemGroup>

  <!-- The default settings are also built into the program: a missing settings file is written again from them. -->
  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" LogicalName="Golether.Web.Server.appsettings.default.json" />
  </ItemGroup>

  <!--
    The administrator guide travels with the program in every package, whatever the system: ADMIN-GUIDE.md in English
    (the main one) and ADMIN-GUIDE.<language>.md for the other languages.
  -->
  <ItemGroup>
    <None Update="ADMIN-GUIDE*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Lets the same program run as a Windows service (the installer registers it) and as a systemd unit. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Transports/Golether.Transports.Rendezvous/Golether.Transports.Rendezvous.csproj" />
    <ProjectReference Include="../../Transports/Golether.Transports.Relay/Golether.Transports.Relay.csproj" />
    <ProjectReference Include="../Golether.Web.Server.Contracts/Golether.Web.Server.Contracts.csproj" />
  </ItemGroup>

  <!--
    The package layout, made when the publish scripts pass -p:GoletherServerPackageRoot=<folder> and publish into
    <folder>/bin:
      <folder>/golether-server(.exe)   the launcher: the same .NET host with the server icon, pointing at bin/
      <folder>/bin/                    the program, the runtime and the libraries
      <folder>/config/appsettings.json the settings (PackageLayout finds them from bin/)
      <folder>/docs/ADMIN-GUIDE*.md    the administrator guide: English, and one file per other language
  -->
  <Target Name="GoletherServerPackageLayout" AfterTargets="Publish" DependsOnTargets="_GetAppHostPaths"
          Condition="'$(GoletherServerPackageRoot)' != ''">
    <PropertyGroup>
      <_ServerPackageRoot>$([MSBuild]::EnsureTrailingSlash('$(GoletherServerPackageRoot)'))</_ServerPackageRoot>
      <_ServerForWindows>$(RuntimeIdentifier.StartsWith('win'))</_ServerForWindows>
      <_ServerLauncherName Condition="'$(_ServerForWindows)' == 'true'">$(AssemblyName).exe</_ServerLauncherName>
      <_ServerLauncherName Condition="'$(_ServerForWindows)' != 'true'">$(AssemblyName)</_ServerLauncherName>
      <_ServerProgramPath Condition="'$(_ServerForWindows)' == 'true'">bin\$(AssemblyName)$(TargetExt)</_ServerProgramPath>
      <_ServerProgramPath Condition="'$(_ServerForWindows)' != 'true'">bin/$(AssemblyName)$(TargetExt)</_ServerProgramPath>
    </PropertyGroup>

    <Error Condition="'$(AppHostSourcePath)' == ''" Text="The package layout needs an application host: publish with a runtime identifier (-r)." />
    <Error Condition="!$([System.String]::Copy('$(PublishDir)').TrimEnd('\/').EndsWith('bin'))" Text="Publish the package into $(_ServerPackageRoot)bin (-o), not into $(PublishDir)." />

    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(_ServerPackageRoot)$(_ServerLauncherName)"
                   AppBinaryName="$(_ServerProgramPath)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="false"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />

    <Copy SourceFiles="$(PublishDir)appsettings.json" DestinationFolder="$(_ServerPackageRoot)config" />
    <ItemGroup>
      <_ServerGuide Include="$(PublishDir)ADMIN-GUIDE*.md" />
    </ItemGroup>
    <Copy SourceFiles="@(_ServerGuide)" DestinationFolder="$(_ServerPackageRoot)docs" />
    <!-- web.config is written for IIS, which the server does not use. -->
    <Delete Files="$(PublishDir)appsettings.json;@(_ServerGuide);$(PublishDir)web.config" />
  </Target>

</Project>
