<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:Golether.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Golether.UI.ViewModels"
        xmlns:vmd="using:Golether.UI.ViewModels.Dialogs"
        x:Class="Golether.UI.Views.Dialogs.SettingsDialog"
        x:DataType="vmd:SettingsViewModel"
        Width="520" SizeToContent="Height" MaxHeight="820" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/golether.ico"
        Title="{Binding Title}">
  <!-- All the settings gathered from the start screen and the session into one place. -->
  <ScrollViewer>
    <StackPanel Margin="22" Spacing="16">
      <TextBlock Classes="title" Text="{loc:Loc Settings.General}" />

      <!-- Language -->
      <StackPanel Spacing="6" IsVisible="{Binding HasLanguage}">
        <TextBlock Classes="label" Text="{loc:Loc Settings.Language}" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Language.Options, FallbackValue={x:Null}}"
                  SelectedItem="{Binding SelectedLanguage}"
                  AutomationProperties.Name="{loc:Loc Main.Language.Name}" ToolTip.Tip="{loc:Loc Main.Language.Tip}"
                  Padding="10,6" CornerRadius="7">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LanguageOption">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="{Binding Flag}" Width="20" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Avatar -->
      <StackPanel Spacing="6" IsVisible="{Binding CanChooseAvatar}">
        <TextBlock Classes="label" Text="{loc:Loc Settings.Avatar}" />
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True" VerticalAlignment="Center"
                  Background="{StaticResource GoletherPanel2}" BorderBrush="{StaticResource GoletherLine}" BorderThickness="1">
            <Panel>
              <TextBlock Classes="muted" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="60"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="{loc:Loc Settings.Avatar.None}" IsVisible="{Binding !HasAvatar}" />
              <Image Source="{Binding AvatarPreview}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
            </Panel>
          </Border>
          <Button Classes="ghost" VerticalAlignment="Center" Command="{Binding ChangeAvatarCommand}">
            <Panel>
              <TextBlock Text="{loc:Loc Settings.Avatar.Set}" IsVisible="{Binding !HasAvatar}" />
              <TextBlock Text="{loc:Loc Settings.Avatar.Change}" IsVisible="{Binding HasAvatar}" />
            </Panel>
          </Button>
        </StackPanel>
      </StackPanel>

      <Border Height="1" Background="{StaticResource GoletherLine}" Margin="0,4" />

      <!-- Camera and microphone -->
      <TextBlock Classes="title" Text="{loc:Loc Settings.CameraMic}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ConferenceNotice}" IsVisible="{Binding !ConferenceAvailable}" />
      <StackPanel Spacing="6" IsVisible="{Binding ConferenceAvailable}">
        <TextBlock Classes="label" Text="{loc:Loc Main.Devices.CameraLabel}" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Devices.Cameras, FallbackValue={x:Null}}"
                  SelectedItem="{Binding SelectedCamera}"
                  AutomationProperties.Name="{loc:Loc Main.Camera.Name}"
                  Padding="10,6" CornerRadius="7" Margin="0,0,0,6" />
        <TextBlock Classes="label" Text="{loc:Loc Main.Devices.MicrophoneLabel}" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Devices.Microphones, FallbackValue={x:Null}}"
                  SelectedItem="{Binding SelectedMicrophone}"
                  AutomationProperties.Name="{loc:Loc Main.Microphone.Name}"
                  Padding="10,6" CornerRadius="7" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Devices.Error, FallbackValue={x:Null}}"
                   IsVisible="{Binding Devices.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Main.Devices.Note}" />
      </StackPanel>

      <Border Height="1" Background="{StaticResource GoletherLine}" Margin="0,4" />

      <!-- Display -->
      <TextBlock Classes="title" Text="{loc:Loc Settings.Display}" />
      <StackPanel Spacing="6">
        <CheckBox IsChecked="{Binding LayoutResizable}" Content="{loc:Loc Settings.Display.Resizable}"
                  AutomationProperties.Name="{loc:Loc Settings.Display.Resizable}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Settings.Display.ResizableNote}" Margin="0,0,0,6" />
        <CheckBox IsChecked="{Binding AlwaysShowBars}" Content="{loc:Loc Settings.Display.AlwaysShowBars}"
                  AutomationProperties.Name="{loc:Loc Settings.Display.AlwaysShowBars}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Settings.Display.AlwaysShowBarsNote}" />
      </StackPanel>

      <Border Height="1" Background="{StaticResource GoletherLine}" Margin="0,4" />

      <!-- AmneziaWG tunnels -->
      <TextBlock Classes="title" Text="{loc:Loc Settings.Tunnels}" />
      <StackPanel Spacing="6">
        <Button Classes="ghost" HorizontalAlignment="Left" Content="{loc:Loc Settings.Tunnels.Configure}"
                Command="{Binding OpenTunnelsCommand}" IsEnabled="{Binding CanConfigureTunnels}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Settings.Tunnels.DisabledInSession}"
                   IsVisible="{Binding !CanConfigureTunnels}" />
      </StackPanel>

      <Border Height="1" Background="{StaticResource GoletherLine}" Margin="0,4" IsVisible="{Binding CanChooseUpdates}" />

      <!-- New versions: told about, never installed by themselves. -->
      <TextBlock Classes="title" Text="{loc:Loc Settings.Updates}" IsVisible="{Binding CanChooseUpdates}" />
      <StackPanel Spacing="6" IsVisible="{Binding CanChooseUpdates}">
        <CheckBox IsChecked="{Binding CheckUpdates}" Content="{loc:Loc Settings.Updates.Check}"
                  AutomationProperties.Name="{loc:Loc Settings.Updates.Check}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Settings.Updates.CheckNote}" Margin="0,0,0,6" />
        <TextBlock Classes="label" Text="{loc:Loc Settings.Updates.Source}" />
        <TextBox Text="{Binding UpdateUrl}" MaxLength="300" PlaceholderText="{Binding DefaultUpdateUrl}"
                 IsEnabled="{Binding CheckUpdates}"
                 AutomationProperties.Name="{loc:Loc Settings.Updates.Source}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Settings.Updates.SourceNote}" />
      </StackPanel>

      <!-- Nothing above is in effect yet: "Apply" hands it over, "Cancel" leaves everything as it was. -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Classes="ghost" Content="{loc:Loc Common.Cancel}" Click="OnCancel" IsCancel="True" />
        <Button Classes="accent" Content="{loc:Loc Common.Apply}" Click="OnApply" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
