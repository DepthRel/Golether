<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:Golether.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Golether.UI.ViewModels.Dialogs"
        x:Class="Golether.UI.Views.Dialogs.TunnelDialog"
        x:DataType="vm:TunnelDialogViewModel"
        Title="{loc:Loc TunnelDialog.WindowTitle}"
        Width="720" Height="720" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" Icon="/Assets/golether.ico">
  <!--
    Peer-to-peer AmneziaWG without a server: the host creates an offer, the participant returns an answer.
    Private keys never leave the device; the preshared key is agreed by ECDH.
  -->
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Classes="title" Text="{loc:Loc TunnelDialog.Heading}" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="{loc:Loc TunnelDialog.Explanation}" />
      <TextBlock TextWrapping="Wrap" Text="{Binding AvailabilityText}"
                 Classes.muted="{Binding !IsAvailable}" />
      <!-- Движок туннеля ставится отсюда же: иначе окно просит сделать то, чего в нём сделать нельзя. -->
      <Panel IsVisible="{Binding NeedsComponent}">
      <Border Classes="card" Padding="12" DataContext="{Binding Component}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Purpose}" />
          <Button Classes="accent" Content="{Binding InstallText}" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
          <StackPanel Spacing="4" IsVisible="{Binding IsInstalling}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Content="{loc:Loc Common.Cancel}" Command="{Binding CancelCommand}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
      </Panel>
      <StackPanel Spacing="4">
        <TextBlock Classes="label" Text="{loc:Loc TunnelDialog.PublicAddressLabel}" />
        <TextBox Text="{Binding PublicAddress}" PlaceholderText="{loc:Loc TunnelDialog.PublicAddressHint}" />
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GoletherSecure}" Text="{Binding Message}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <!-- Туннель и так опустится при выходе из Golether; кнопка нужна, чтобы не ждать выхода. -->
        <Button Classes="ghost" Content="{loc:Loc TunnelDialog.Drop}" Command="{Binding DropCommand}" IsVisible="{Binding HasRaisedTunnels}"
                ToolTip.Tip="{loc:Loc TunnelDialog.DropTip}" />
        <Button Classes="ghost" Content="{loc:Loc Common.Close}" Click="OnClose" IsCancel="True" />
      </StackPanel>
    </StackPanel>

    <TabControl>
      <TabItem Header="{loc:Loc TunnelDialog.HostTab}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,12,8,0">
            <TextBlock Classes="label" Text="{loc:Loc TunnelDialog.HostStep1}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="{loc:Loc TunnelDialog.CreateOffer}" Command="{Binding CreateOfferCommand}" />
              <Button Classes="ghost" Content="{loc:Loc Common.Copy}" Command="{Binding CopyOfferCommand}" />
            </StackPanel>
            <TextBox Classes="package" IsReadOnly="True" Text="{Binding OfferText}" PlaceholderText="golether-awg:offer:v1:…" />
            <TextBlock Classes="label" Text="{loc:Loc TunnelDialog.HostStep2}" />
            <TextBox Classes="package" Text="{Binding AnswerInput}" PlaceholderText="golether-awg:answer:v1:…" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="{loc:Loc Common.Paste}" Command="{Binding PasteAnswerCommand}" />
              <Button Classes="accent" Content="{loc:Loc TunnelDialog.AcceptAnswer}" Command="{Binding CompleteOfferCommand}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{Binding HostResult}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasHostConfiguration}">
              <Button Classes="accent" Content="{loc:Loc Common.RaiseTunnel}" Command="{Binding ApplyHostCommand}" IsEnabled="{Binding IsAvailable}" />
              <Button Classes="ghost" Content="{loc:Loc Common.ExportConf}" Command="{Binding ExportHostCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Loc TunnelDialog.ParticipantTab}">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,12,8,0">
            <TextBlock Classes="label" Text="{loc:Loc TunnelDialog.ParticipantStep1}" />
            <TextBox Classes="package" Text="{Binding OfferInput}" PlaceholderText="golether-awg:offer:v1:…" />
            <Grid ColumnDefinitions="Auto,12,160,*">
              <Button Classes="ghost" Content="{loc:Loc Common.Paste}" Command="{Binding PasteOfferCommand}" VerticalAlignment="Bottom" />
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Classes="label" Text="{loc:Loc TunnelDialog.UdpPort}" />
                <NumericUpDown Value="{Binding ListenPort}" Minimum="1024" Maximum="65535" FormatString="0" />
              </StackPanel>
            </Grid>
            <Button Classes="accent" Content="{loc:Loc TunnelDialog.AcceptOffer}" Command="{Binding AcceptOfferCommand}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding ParticipantResult}" />
            <TextBlock Classes="label" Text="{loc:Loc TunnelDialog.ParticipantStep2}" />
            <TextBox Classes="package" IsReadOnly="True" Text="{Binding AnswerText}" PlaceholderText="golether-awg:answer:v1:…" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="{loc:Loc TunnelDialog.CopyAnswer}" Command="{Binding CopyAnswerCommand}" />
              <Button Classes="accent" Content="{loc:Loc Common.RaiseTunnel}" Command="{Binding ApplyParticipantCommand}" IsVisible="{Binding HasParticipantConfiguration}" IsEnabled="{Binding IsAvailable}" />
              <Button Classes="ghost" Content="{loc:Loc Common.ExportConf}" Command="{Binding ExportParticipantCommand}" IsVisible="{Binding HasParticipantConfiguration}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
