<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Golether.UI.App"
             Name="Golether"
             RequestedThemeVariant="Dark">
  <!-- Fluent in the dark variant plus the Golether palette and control classes. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Golether/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
