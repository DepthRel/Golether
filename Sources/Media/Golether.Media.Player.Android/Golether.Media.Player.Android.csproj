<Project Sdk="Microsoft.NET.Sdk">

  <!-- What libmpv needs from Android: the hardware decoders of FFmpeg reach MediaCodec through JNI. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>Golether.Media.Player.Android</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
