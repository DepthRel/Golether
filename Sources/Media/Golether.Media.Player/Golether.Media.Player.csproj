<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Local media players: libmpv through P/Invoke (embedded into a native window, custom golether:// stream protocol)
    and a simulated player for development and tests when libmpv is not installed.
  -->
  <PropertyGroup>
    <RootNamespace>Golether.Media.Player</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Golether.Core\Golether.Core.csproj" />
    <ProjectReference Include="..\Golether.Media.Streaming\Golether.Media.Streaming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Golether.Media.Player.Tests" />
  </ItemGroup>

</Project>
